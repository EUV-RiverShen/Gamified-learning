rules_version = '2';

// Kein direkter Client-Zugriff auf Firestore — der App-Zustand läuft ausschließlich
// über die "storage"-Cloud-Function (Admin SDK, umgeht diese Regeln ohnehin).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
